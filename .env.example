# Copy this file to .env for LOCAL testing only.
# In GitHub Actions, these same names are set as encrypted repository secrets instead —
# never commit a real .env file.

# PostgreSQL connection string (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# SportsDataIO API key (from https://sportsdata.io account dashboard) — primary source
SPORTSDATAIO_API_KEY=your_sportsdataio_key_here

# The Odds API key (from https://the-odds-api.com account dashboard) — optional,
# supplementary odds source. Leave blank to skip it; SportsDataIO odds still run.
ODDS_API_KEY=your_odds_api_key_here

# Default sport/league to pull if not passed as a CLI arg (nfl, mlb, nba, ncaaf, ncaab)
DEFAULT_SPORT=nfl
